{
  "manifest_version": 3,
  "name": "Lambda Rackside",
  "short_name": "Rackside",
  "version": "1.31.0",
  "description": "Lambda Rackside: the DC Ops ticket assistant. A brief for Jira tickets: power-down safety, server & location, NetBox, BMC health, parts catalog & spare stock, Slack — with Claude, OpenAI, Gemini or a local model.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "tabs",
    "nativeMessaging",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://netbox.prod.lambdalabs.cloud/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://docs.google.com/*",
    "https://app.slack.com/*",
    "https://*.googleusercontent.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://codeload.github.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Lambda Rackside",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
